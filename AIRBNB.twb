      <aliases enabled='yes' />
      <column caption='Performance score' datatype='integer' name='[Calculation_0608639856791552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='PRICE CATEGORY' datatype='string' name='[Calculation_0608639858069505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; 300 THEN &quot;LUXURY&quot; &#13;&#10;ELSEIF [Price]&gt; 150 THEN &quot;STANDARD&quot; &#13;&#10;ELSE &quot;BUDGET&quot; END' />
      </column>
      <column caption='COUNT OF HOTEL' datatype='integer' name='[Calculation_0608639860981762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='HOST STATUS' datatype='string' name='[Calculation_0608639864991747]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt; TODAY() THEN &quot;ACTIVE HOST&quot; ELSE &quot;NEW HOST&quot; END' />
      </column>
      <column caption='REVIEW CATEGORY' datatype='string' name='[Calculation_0608639865765892]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;=100 THEN &quot;HIGHLY REVIEWED&quot; &#13;&#10;ELSE &quot;LESS REVIEWED&quot; END' />
      </column>
      <column caption='PRICE FILTER CATEGORY' datatype='string' name='[Calculation_0608639867568135]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt; [Parameters].[Parameter 0608639866732550] THEN &quot;ABOVE LIMIT&quot; ELSE &quot;BELOW LIMIT&quot; END' />
      </column>
      <column caption='HOST SINCE NEW' datatype='date' name='[Calculation_0608639876206601]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='REVIEW SCORE RATING BIN' datatype='string' name='[Calculation_0608639876747274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating]),&quot;NOT RATED&quot;)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
